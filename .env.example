# Copy this file to .env and fill in what you need, then:
#   docker compose up -d                      (dashboard only)
#   docker compose --profile timetree up -d   (dashboard + TimeTree sidecar)

# Editor PIN for /edit. Leave blank to use ./data/edit-pin (sqndash --set-pin) instead.
EDIT_PIN=

# --- Only needed if you're using the TimeTree calendar source ---
# https://github.com/mr-onadasky/timetree-live-ics
TIMETREE_EMAIL=
TIMETREE_PASSWORD=
TIMETREE_CALENDAR_CODE=
TIMETREE_CRON_SCHEDULE=*/30 * * * *
